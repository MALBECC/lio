@PACKAGE_INIT@

# g2g CMake Configuration File
# 
# This file provides the following variables:
#   g2g_FOUND         - True if g2g was found
#   g2g_VERSION       - Version of g2g that was found
#   g2g_USE_CUDA      - Whether g2g was built with CUDA support
#   g2g_USE_CUBLAS    - Whether g2g was built with CUBLAS support
#   g2g_USE_MAGMA     - Whether g2g was built with MAGMA support
#   g2g_USE_LIBXC_CPU - Whether g2g was built with LIBXC CPU support
#   g2g_USE_LIBXC_GPU - Whether g2g was built with LIBXC GPU support
#   g2g_USE_LIBINT    - Whether g2g was built with LIBINT support
#
# The following imported targets are provided:
#   g2g::g2g          - The g2g library

include(CMakeFindDependencyMacro)

# Store the g2g configuration options
set(g2g_USE_CUDA      @USE_CUDA@)
set(g2g_USE_CUBLAS    @USE_CUBLAS@)
set(g2g_USE_MAGMA     @USE_MAGMA@)
set(g2g_USE_LIBXC_CPU @USE_LIBXC_CPU@)
set(g2g_USE_LIBXC_GPU @USE_LIBXC_GPU@)
set(g2g_USE_LIBINT    @USE_LIBINT@)
set(g2g_USE_MKL       @USE_MKL@)
set(g2g_USE_PARALLEL  @USE_PARALLEL@)

# Find required dependencies based on how g2g was built

# OpenMP (if enabled)
if(@USE_PARALLEL@)
    find_dependency(OpenMP)
endif()

# Linear algebra libraries
if(@USE_MKL@ AND "@CMAKE_CXX_COMPILER_ID@" MATCHES "Intel")
    # Intel MKL
    if(NOT MKL_FOUND)
        set(MKL_FIND_QUIETLY TRUE)
        find_dependency(MKL)
    endif()
else()
    # Standard BLAS/LAPACK
    find_dependency(BLAS)
    find_dependency(LAPACK)
endif()

# CUDA dependencies
if(@USE_CUDA@)
    # Enable CUDA language if not already enabled
    if(NOT CMAKE_CUDA_COMPILER)
        enable_language(CUDA)
    endif()
    
    find_dependency(CUDAToolkit @CUDAToolkit_VERSION@)
    
    # Check CUDA version compatibility
    if(CUDAToolkit_VERSION VERSION_GREATER "11.99")
        message(WARNING "g2g was built with CUDA @CUDAToolkit_VERSION@, but CUDA 12+ compatibility is experimental")
    endif()
    
    # MAGMA (if enabled)
    if(@USE_MAGMA@)
        # First, add the custom FindMAGMA.cmake path if it exists
        set(CMAKE_MODULE_PATH_OLD ${CMAKE_MODULE_PATH})
        list(APPEND CMAKE_MODULE_PATH "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@/cmake/g2g/modules")
        
        find_dependency(MAGMA)
        
        # Restore original module path
        set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH_OLD})
    endif()
endif()

# LIBXC dependencies
if(@USE_LIBXC_CPU@ OR @USE_LIBXC_GPU@)
    # Add custom module path for FindLibXC.cmake
    set(CMAKE_MODULE_PATH_OLD ${CMAKE_MODULE_PATH})
    list(APPEND CMAKE_MODULE_PATH "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@/cmake/g2g/modules")
    
    if(@USE_LIBXC_CPU@)
        find_dependency(LibXC)
    endif()
    
    if(@USE_LIBXC_GPU@)
        find_dependency(LibXC-GPU)
        # GPU version also needs CPU LibXC
        if(NOT LibXC_FOUND)
            find_dependency(LibXC)
        endif()
    endif()
    
    # Restore original module path
    set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH_OLD})
endif()

# LIBINT dependencies
if(@USE_LIBINT@)
    # Add custom module path for FindLibint.cmake
    set(CMAKE_MODULE_PATH_OLD ${CMAKE_MODULE_PATH})
    list(APPEND CMAKE_MODULE_PATH "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@/cmake/g2g/modules")
    
    find_dependency(Libint)
    find_dependency(Eigen3)
    
    # Restore original module path
    set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH_OLD})
endif()

# GSL dependency (for surface hopping)
if(@BUILD_SURFACE_HOPPING@)
    find_dependency(GSL)
endif()

# System libraries that might be needed
include(CheckLibraryExists)
check_library_exists(m sin "" HAVE_LIB_M)
check_library_exists(rt clock_gettime "" HAVE_LIB_RT)

# Include the targets file
if(NOT TARGET g2g::g2g)
    include("${CMAKE_CURRENT_LIST_DIR}/g2gTargets.cmake")
endif()

# Verify that all required components are available
set(g2g_FOUND TRUE)
set(g2g_VERSION @PROJECT_VERSION@)

# Provide informative messages
if(NOT g2g_FIND_QUIETLY)
    message(STATUS "Found g2g: ${CMAKE_CURRENT_LIST_DIR}")
    message(STATUS "  Version: ${g2g_VERSION}")
    message(STATUS "  CUDA support: ${g2g_USE_CUDA}")
    if(g2g_USE_CUDA)
        message(STATUS "    CUBLAS: ${g2g_USE_CUBLAS}")
        message(STATUS "    MAGMA: ${g2g_USE_MAGMA}")
    endif()
    message(STATUS "  LIBXC support: CPU=${g2g_USE_LIBXC_CPU}, GPU=${g2g_USE_LIBXC_GPU}")
    message(STATUS "  LIBINT support: ${g2g_USE_LIBINT}")
    message(STATUS "  OpenMP support: ${g2g_USE_PARALLEL}")
endif()

# Check for required components
check_required_components(g2g)